{
  "name": "@quaannguyen/xor",
  "version": "0.1.2",
  "description": "Action gate for agent tool calls using a system-one needle model, and a desktop companion.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/QuaanNguyen/xor.git"
  },
  "bugs": {
    "url": "https://github.com/QuaanNguyen/xor/issues"
  },
  "homepage": "https://github.com/QuaanNguyen/xor#readme",
  "bin": {
    "xor": "scripts/xor.js"
  },
  "files": [
    "events/",
    "xor/",
    "!xor/prototype/",
    "pet/",
    "!pet/node_modules/",
    "plugin/",
    "scripts/xor.js",
    "scripts/build-native-pet.js",
    "scripts/check-package-client.js",
    "scripts/check-package.js",
    "scripts/check-syntax.js",
    "scripts/install-plugin.js",
    "scripts/migrate.js",
    "scripts/run-e2e.js",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "check": "node scripts/check-syntax.js",
    "eval:gate": "node scripts/evaluate-gate.js",
    "eval:verifier": "node scripts/evaluate-gate.js",
    "test": "node --test test/unit/*.test.js test/integration/*.test.js test/plugin/*.test.mjs test/xor/*.test.js",
    "test:e2e": "node scripts/run-e2e.js",
    "test:e2e:skip-native": "node scripts/run-e2e.js --skip-native",
    "test:e2e:opencode": "python3 test/e2e/opencode-pet-lifecycle.test.py",
    "test:integration": "node --test test/integration/*.test.js",
    "test:package": "node scripts/check-package.js",
    "test:package:client": "node scripts/check-package-client.js npm",
    "test:unit": "node --test test/unit/*.test.js",
    "prototype:finetune": "node xor/prototype/checker-data.js",
    "check:checker-promotion": "node xor/prototype/checker-promotion.js",
    "dev:generate-data": "node xor/prototype/dev-generate-data.js"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
