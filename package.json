{
  "name": "border-collie",
  "version": "0.1.0",
  "private": true,
  "description": "A guard and desktop companion for OpenCode coding agents.",
  "license": "MIT",
  "bin": {
    "border-collie": "scripts/border-collie.js"
  },
  "files": [
    "events/",
    "guard/",
    "pet/",
    "!pet/node_modules/",
    "plugin/",
    "scripts/border-collie.js",
    "scripts/build-native-pet.js",
    "scripts/check-package-client.js",
    "scripts/check-package.js",
    "scripts/check-syntax.js",
    "scripts/install-plugin.js",
    "scripts/run-e2e.js",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "check": "node scripts/check-syntax.js",
    "test": "node --test test/unit/*.test.js test/integration/*.test.js",
    "test:e2e": "node scripts/run-e2e.js",
    "test:e2e:skip-native": "node scripts/run-e2e.js --skip-native",
    "test:integration": "node --test test/integration/*.test.js",
    "test:package": "node scripts/check-package.js",
    "test:package:client": "node scripts/check-package-client.js",
    "test:unit": "node --test test/unit/*.test.js"
  }
}
