{
  "name": "@quaannguyen/bordercollie",
  "version": "0.1.2",
  "description": "Permission decisions and a desktop companion for coding agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/QuaanNguyen/border-collie.git"
  },
  "bugs": {
    "url": "https://github.com/QuaanNguyen/border-collie/issues"
  },
  "homepage": "https://github.com/QuaanNguyen/border-collie#readme",
  "bin": {
    "bordercollie": "scripts/bordercollie.js"
  },
  "files": [
    "events/",
    "bordercollie/",
    "!bordercollie/prototype/",
    "pet/",
    "!pet/node_modules/",
    "plugin/",
    "scripts/bordercollie.js",
    "scripts/build-native-pet.js",
    "scripts/check-package-client.js",
    "scripts/check-package.js",
    "scripts/check-syntax.js",
    "scripts/install-plugin.js",
    "scripts/migrate.js",
    "scripts/run-e2e.js",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "check": "node scripts/check-syntax.js",
    "eval:judge": "node scripts/evaluate-judge.js",
    "test": "node --test test/unit/*.test.js test/integration/*.test.js",
    "test:e2e": "node scripts/run-e2e.js",
    "test:e2e:skip-native": "node scripts/run-e2e.js --skip-native",
    "test:integration": "node --test test/integration/*.test.js",
    "test:package": "node scripts/check-package.js",
    "test:package:client": "node scripts/check-package-client.js npm",
    "test:unit": "node --test test/unit/*.test.js",
    "prototype:finetune": "node bordercollie/prototype/checker-data.js",
    "check:checker-promotion": "node bordercollie/prototype/checker-promotion.js",
    "dev:generate-data": "node bordercollie/prototype/dev-generate-data.js"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
