# PROTOTYPE — wipe or ignore. Gitignored copy lives in .env.
# Paste the Voyager LLM Access key. The prototype sends it as
# Authorization: Bearer to https://openai.rc.asu.edu/v1
# Docs: https://docs.rc.asu.edu/ai/api/

AIR_API_KEY=

OPENAI_BASE_URL=https://openai.rc.asu.edu/v1

# Two different model families. Copy ids exactly from the portal
# or from `npm run prototype:finetune` after the key is set.
# Examples: qwen38-27b, muse-glimmer-30b, devstral2-123b
ASU_PROPOSER_MODEL=
ASU_LABELER_MODEL=
